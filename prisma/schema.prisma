generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MeetingStatus {
  created
  awaiting_consent
  connecting
  live
  paused
  stopping
  finalizing
  ready
  degraded
  failed
  deleted
}

enum SourceMode {
  meet_api
  browser_capture
  manual_import
}

enum TranscriptSource {
  stt_stream
  meet_api
  import
  user_edit
}

enum ActionStatus {
  proposed
  confirmed
  completed
}

enum DecisionStatus {
  proposed
  confirmed
  withdrawn
}

enum MembershipRole {
  owner
  admin
  member
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String?   @unique
  emailVerified         DateTime?
  image                 String?
  googleSubject         String?   @unique
  retentionDays         Int       @default(30)
  storeAudio            Boolean   @default(false)
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  meetings      Meeting[]
  consentEvents ConsentEvent[]
  auditEvents   AuditEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("free")
  createdAt DateTime @default(now())

  memberships Membership[]
  meetings    Meeting[]
  auditEvents AuditEvent[]
}

model Membership {
  id        String         @id @default(cuid())
  orgId     String
  userId    String
  role      MembershipRole @default(member)
  createdAt DateTime       @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model Meeting {
  id                String        @id @default(cuid())
  userId            String
  orgId             String?
  provider          String        @default("google_meet")
  externalMeetingId String?
  meetUrl           String
  title             String
  startedAt         DateTime?
  endedAt           DateTime?
  status            MeetingStatus @default(created)
  sourceMode        SourceMode    @default(browser_capture)
  language          String?
  health            String        @default("disconnected")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?     @relation(fields: [orgId], references: [id], onDelete: SetNull)
  participants  Participant[]
  segments      TranscriptSegment[]
  state         MeetingState?
  decisions     Decision[]
  actionItems   ActionItem[]
  evidenceLinks EvidenceLink[]
  revisions     AIRevision[]
  consentEvents ConsentEvent[]
  exportJobs    ExportJob[]

  @@index([userId, startedAt])
  @@index([orgId, startedAt])
  @@index([status])
}

model Participant {
  id                     String  @id @default(cuid())
  meetingId              String
  externalParticipantRef String?
  displayName            String
  email                  String?
  speakerLabel           String

  meeting     Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  segments    TranscriptSegment[]
  actionItems ActionItem[]

  @@index([meetingId])
}

model TranscriptSegment {
  id            String           @id @default(cuid())
  meetingId     String
  participantId String?
  seq           Int
  text          String
  startAt       DateTime
  endAt         DateTime
  language      String?
  isFinal       Boolean          @default(true)
  source        TranscriptSource @default(stt_stream)
  modifiedAt    DateTime?

  meeting     Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant Participant?  @relation(fields: [participantId], references: [id], onDelete: SetNull)
  evidence    EvidenceLink[]

  @@unique([meetingId, seq])
  @@index([meetingId, startAt])
}

model MeetingState {
  meetingId     String  @id
  version       Int     @default(1)
  summary       String  @default("")
  topicsJson    Json    @default("[]")
  decisionsJson Json    @default("[]")
  actionsJson   Json    @default("[]")
  questionsJson Json    @default("[]")
  risksJson     Json    @default("[]")
  updatedAt     DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model Decision {
  id          String         @id @default(cuid())
  meetingId   String
  title       String
  description String
  confidence  Float
  status      DecisionStatus @default(proposed)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model ActionItem {
  id                 String       @id @default(cuid())
  meetingId          String
  task               String
  ownerParticipantId String?
  dueAt              DateTime?
  confidence         Float
  status             ActionStatus @default(proposed)
  userEdited         Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  meeting Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  owner   Participant? @relation(fields: [ownerParticipantId], references: [id], onDelete: SetNull)

  @@index([meetingId])
}

model EvidenceLink {
  id                  String @id @default(cuid())
  entityType          String
  entityId            String
  transcriptSegmentId String
  meetingId           String

  meeting Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  segment TranscriptSegment @relation(fields: [transcriptSegmentId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([transcriptSegmentId])
}

model AIRevision {
  id            String   @id @default(cuid())
  meetingId     String
  revisionNo    Int
  model         String
  promptVersion String
  outputJson    Json
  createdAt     DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, revisionNo])
}

model ConsentEvent {
  id           String   @id @default(cuid())
  meetingId    String
  userId       String
  eventType    String
  timestamp    DateTime @default(now())
  metadataJson Json     @default("{}")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model ExportJob {
  id          String   @id @default(cuid())
  meetingId   String
  destination String
  status      String   @default("queued")
  resultRef   String?
  createdAt   DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id           String   @id @default(cuid())
  orgId        String?
  userId       String?
  actorId      String
  action       String
  resourceType String
  resourceId   String
  createdAt    DateTime @default(now())

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
